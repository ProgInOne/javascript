{
  "name": "proginone",
  "version": "0.0.0",
  "private": true,
  "description": "로컬에서 실행하는 AI 기반 개인 맞춤 웹 개발 학습 플랫폼",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @proginone/server --filter @proginone/web dev",
    "start": "pnpm --filter @proginone/server start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --parallel --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && pnpm --filter @proginone/e2e test",
    "test:e2e:visual": "bash tools/e2e-docker.sh",
    "content:check": "node tools/content-cli/src/cli.ts check --dir content",
    "content:check:run": "node tools/content-cli/src/cli.ts check --dir content --run",
    "content:build": "node tools/content-cli/src/cli.ts build --dir content --out content/dist/content.db",
    "content:build:dev": "node tools/content-cli/src/cli.ts build --dir content --out content/dist/content.db --include-drafts",
    "build": "pnpm -r --if-present build",
    "check:deps": "depcruise apps packages tools --config .dependency-cruiser.cjs",
    "check:links": "node tools/check-links.mjs",
    "check:contrast": "pnpm --filter @proginone/ui check:contrast",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm check:deps && pnpm check:contrast && pnpm test && pnpm check:links"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
