    "@proginone/shared": "0.2.0-next.20261123095345",
    "better-sqlite3": "^13.2.0",
    "drizzle-orm": "^0.45.4",
    "env-paths": "^4.0.0",
    "hono": "^4.13.19",
    "pino": "^10.4.0",
    "ulid": "^3.0.2",
    "zod": "^4.6.7"
  },
