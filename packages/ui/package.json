{
  "name": "@proginone/ui",
  "version": "0.0.0",
  "private": true,
  "description": "디자인 토큰과 기본 React 컴포넌트",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens/tokens.css",
    "./fonts.css": "./src/tokens/fonts.css",
    "./base.css": "./src/tokens/base.css",
    "./components.css": "./src/components/components.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p scripts/tsconfig.json",
    "check:contrast": "node scripts/check-contrast.ts"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "lucide-react": "^1.73.0",
    "pretendard": "^1.3.9",
    "radix-ui": "^1.8.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.1",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
