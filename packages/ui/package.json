{
  "name": "@proginone/ui",
  "version": "0.0.0",
  "private": true,
  "description": "디자인 토큰과 기본 React 컴포넌트",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens/tokens.css",
    "./fonts.css": "./src/tokens/fonts.css",
    "./base.css": "./src/tokens/base.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p scripts/tsconfig.json",
    "check:contrast": "node scripts/check-contrast.ts"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "pretendard": "^1.3.9"
  }
}
